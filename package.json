{
  "name": "sessionkeeper",
  "displayName": "SessionKeeper",
  "description": "Back up and rescue your AI coding sessions, locally. Keeps a versioned copy of every session — transcript, subagents and tool outputs — so nothing is gone when retention, an update or a crash wipes it. Works with Claude Code. Local-first, no telemetry. Not affiliated with Anthropic or OpenAI.",
  "version": "0.2.2",
  "publisher": "argalla",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude code",
    "codex",
    "ai agent",
    "session history",
    "backup",
    "restore",
    "transcript",
    "recovery",
    "archive",
    "jsonl"
  ],
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/TecniartGalicia/sessionkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/TecniartGalicia/sessionkeeper/issues"
  },
  "homepage": "https://github.com/TecniartGalicia/sessionkeeper#readme",
  "qna": "https://github.com/TecniartGalicia/sessionkeeper/discussions",
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "npm run build && npm run compile-tests && node ./out/test/integration/runTest.js",
    "l10n": "node scripts/l10n-sync.mjs",
    "package": "vsce package --no-dependencies",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "npm run build && npm run compile-tests && node ./out/test/demo/runDemo.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/vscode": "1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "mocha": "^11.1.0",
    "ovsx": "^1.1.1",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionkeeper",
          "title": "SessionKeeper",
          "icon": "media/view-icon.svg"
        }
      ]
    },
    "views": {
      "sessionkeeper": [
        {
          "id": "sessionkeeper.sessions",
          "name": "%view.sessions%",
          "icon": "media/view-icon.svg",
          "contextualTitle": "SessionKeeper"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sessionkeeper.sessions",
        "contents": "%welcome.empty%"
      }
    ],
    "commands": [
      {
        "command": "sessionkeeper.backupAll",
        "title": "%cmd.backupAll%",
        "category": "SessionKeeper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sessionkeeper.backupSession",
        "title": "%cmd.backupSession%",
        "category": "SessionKeeper",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "sessionkeeper.restoreSession",
        "title": "%cmd.restoreSession%",
        "category": "SessionKeeper",
        "icon": "$(history)"
      },
      {
        "command": "sessionkeeper.exportSession",
        "title": "%cmd.exportSession%",
        "category": "SessionKeeper",
        "icon": "$(markdown)"
      },
      {
        "command": "sessionkeeper.doctor",
        "title": "%cmd.doctor%",
        "category": "SessionKeeper",
        "icon": "$(pulse)"
      },
      {
        "command": "sessionkeeper.refresh",
        "title": "%cmd.refresh%",
        "category": "SessionKeeper",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionkeeper.openVault",
        "title": "%cmd.openVault%",
        "category": "SessionKeeper"
      },
      {
        "command": "sessionkeeper.showStorage",
        "title": "%cmd.showStorage%",
        "category": "SessionKeeper"
      },
      {
        "command": "sessionkeeper.showLog",
        "title": "%cmd.showLog%",
        "category": "SessionKeeper"
      },
      {
        "command": "sessionkeeper.pro.activate",
        "title": "%cmd.pro.activate%",
        "category": "SessionKeeper Pro"
      },
      {
        "command": "sessionkeeper.pro.deactivate",
        "title": "%cmd.pro.deactivate%",
        "category": "SessionKeeper Pro"
      },
      {
        "command": "sessionkeeper.pro.status",
        "title": "%cmd.pro.status%",
        "category": "SessionKeeper Pro"
      },
      {
        "command": "sessionkeeper.pro.buy",
        "title": "%cmd.pro.buy%",
        "category": "SessionKeeper Pro"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sessionkeeper.backupSession",
          "when": "false"
        },
        {
          "command": "sessionkeeper.exportSession",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sessionkeeper.backupAll",
          "when": "view == sessionkeeper.sessions",
          "group": "navigation@1"
        },
        {
          "command": "sessionkeeper.doctor",
          "when": "view == sessionkeeper.sessions",
          "group": "navigation@2"
        },
        {
          "command": "sessionkeeper.refresh",
          "when": "view == sessionkeeper.sessions",
          "group": "navigation@3"
        },
        {
          "command": "sessionkeeper.openVault",
          "when": "view == sessionkeeper.sessions",
          "group": "1_info@1"
        },
        {
          "command": "sessionkeeper.showStorage",
          "when": "view == sessionkeeper.sessions",
          "group": "1_info@2"
        },
        {
          "command": "sessionkeeper.pro.status",
          "when": "view == sessionkeeper.sessions",
          "group": "2_pro@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionkeeper.backupSession",
          "when": "view == sessionkeeper.sessions && viewItem =~ /^sk\\.session/",
          "group": "inline@1"
        },
        {
          "command": "sessionkeeper.restoreSession",
          "when": "view == sessionkeeper.sessions && viewItem =~ /^sk\\.session/",
          "group": "inline@2"
        },
        {
          "command": "sessionkeeper.backupSession",
          "when": "view == sessionkeeper.sessions && viewItem =~ /^sk\\.session/",
          "group": "1_backup@1"
        },
        {
          "command": "sessionkeeper.restoreSession",
          "when": "view == sessionkeeper.sessions && viewItem =~ /^sk\\.session/",
          "group": "1_backup@2"
        },
        {
          "command": "sessionkeeper.exportSession",
          "when": "view == sessionkeeper.sessions && viewItem =~ /^sk\\.session/",
          "group": "2_export@1"
        }
      ]
    },
    "configuration": {
      "title": "SessionKeeper",
      "properties": {
        "sessionkeeper.vaultPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%cfg.vaultPath%"
        },
        "sessionkeeper.claudeHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%cfg.claudeHome%"
        },
        "sessionkeeper.includeCodex": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%cfg.includeCodex%"
        },
        "sessionkeeper.autoBackup": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "%cfg.autoBackup%"
        }
      }
    }
  },
  "allowScripts": {
    "@vscode/vsce-sign@2.0.9": true,
    "esbuild@0.28.2": true
  },
  "pricing": "Trial"
}